# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Neon PostgreSQL ──────────────────────────────────────
# Get these from neon.tech → your project → Connection Details
# Click "Connection string" → copy the two URLs below
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ─── JWT ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Redis (Optional — app works without it) ──────────────
# Get free Redis at: upstash.com
REDIS_URL=

# ─── Stripe (Optional — leave blank to skip payments) ─────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# ─── OpenAI ───────────────────────────────────────────────
# Get from: platform.openai.com → API keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Email (Optional — leave blank to skip emails) ────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
FROM_EMAIL=noreply@lifeos.app
FROM_NAME=LifeOS

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── App ──────────────────────────────────────────────────
APP_NAME=LifeOS
BCRYPT_SALT_ROUNDS=12
MAX_AI_REQUESTS_PER_DAY=50
